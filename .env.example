# Example env vars. Copy to `.env` and fill in values. `.env` is gitignored.
#
# These are read by the Lark smoke tests under
# `src-tauri/tests/lark_smoke.rs`. The tests are `#[ignore]` by default;
# run them locally with:
#
#   cd src-tauri && cargo test --test lark_smoke -- --ignored --nocapture
#
# NEVER commit a populated `.env` — `LARK_APP_SECRET` is a tenant-level
# credential and is treated as a secret throughout the app
# (keyring-stored at runtime, never logged).

# Required for any Lark smoke test.
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=
LARK_APP_TOKEN=bascnxxxxxxxxxxxxxx
LARK_TABLE_ID=tblxxxxxxxxxxxxxx

# Optional: override the API host. Defaults to
# https://open.larksuite.com (international). Use
# https://open.feishu.cn for China-mainland tenants.
# LARK_BASE_URL=https://open.feishu.cn

# Optional: required only for the create+delete smoke test. Name of a
# text-typed column in the target table that the smoke test can write
# a probe value into. The test deletes the row immediately, but pick a
# field whose presence in the audit log you're comfortable with.
# LARK_SMOKE_FIELD=Title
